(event EventReceiveDrawHUD (SizeX SizeY)
  (bind p (Utilities|Casting|CastToBP_EscapePlayer :Object (Game|GetPlayerCharacter))
    (:then
      (HUD|DrawRect :RectColor "(R=0.015,G=0.025,B=0.035,A=0.88)" :ScreenX 24.0 :ScreenY 24.0 :ScreenW 610.0 :ScreenH 118.0)
      (HUD|DrawRect :RectColor "(R=0.1,G=0.85,B=0.75,A=1)" :ScreenX 24.0 :ScreenY 24.0 :ScreenW 4.0 :ScreenH 118.0)
      (HUD|DrawText :Text "COMPOUND / BREACH" :TextColor "(R=0.1,G=0.85,B=0.75,A=1)" :ScreenX 42.0 :ScreenY 36.0 :Scale 1.5)
      (HUD|DrawText :Text (Class|BPEscapePlayer|GetObjective :self p) :TextColor "(R=1,G=1,B=1,A=1)" :ScreenX 42.0 :ScreenY 69.0 :Scale 1.1)
      (HUD|DrawText :Text (select (Class|BPEscapePlayer|GetHasKeycard :self p) "KEYCARD: ACQUIRED" "KEYCARD: MISSING") :TextColor "(R=0.85,G=0.8,B=0.55,A=1)" :ScreenX 42.0 :ScreenY 108.0)
      (HUD|DrawText :Text (select (Class|BPEscapePlayer|GetPowerOnline :self p) "POWER: ONLINE" "POWER: OFFLINE") :TextColor "(R=0.85,G=0.8,B=0.55,A=1)" :ScreenX 280.0 :ScreenY 108.0)
      (HUD|DrawText :Text "+" :TextColor "(R=1,G=1,B=1,A=0.8)" :ScreenX (- (* SizeX 0.5) 4.0) :ScreenY (- (* SizeY 0.5) 8.0))
      (HUD|DrawRect :RectColor "(R=0.015,G=0.025,B=0.035,A=0.8)" :ScreenX 24.0 :ScreenY (- SizeY 76.0) :ScreenW 610.0 :ScreenH 52.0)
      (HUD|DrawText :Text (Class|BPEscapePlayer|GetPrompt :self p) :TextColor "(R=0.2,G=1,B=0.8,A=1)" :ScreenX 42.0 :ScreenY (- SizeY 69.0) :Scale 1.2)
      (HUD|DrawText :Text "WASD  Move     MOUSE  Look     SPACE  Jump     E  Interact     R  Restart" :TextColor "(R=0.65,G=0.72,B=0.78,A=1)" :ScreenX 42.0 :ScreenY (- SizeY 43.0))
      (if (Class|BPEscapePlayer|GetEscaped :self p)
        (HUD|DrawRect :RectColor "(R=0.01,G=0.03,B=0.04,A=0.92)" :ScreenX (- (* SizeX 0.5) 260.0) :ScreenY (- (* SizeY 0.5) 80.0) :ScreenW 520.0 :ScreenH 160.0)
        (HUD|DrawText :Text "ESCAPE COMPLETE" :TextColor "(R=0.1,G=1,B=0.75,A=1)" :ScreenX (- (* SizeX 0.5) 175.0) :ScreenY (- (* SizeY 0.5) 35.0) :Scale 2.4)
        (HUD|DrawText :Text "You restored power, secured access, and breached the compound." :TextColor "(R=1,G=1,B=1,A=1)" :ScreenX (- (* SizeX 0.5) 220.0) :ScreenY (+ (* SizeY 0.5) 14.0))
        (HUD|DrawText :Text "Press R to replay" :TextColor "(R=1,G=1,B=1,A=1)" :ScreenX (- (* SizeX 0.5) 65.0) :ScreenY (+ (* SizeY 0.5) 42.0))))
    (:CastFailed)))
