(event EventBeginPlay
  (Input|SetInputModeGameOnly :PlayerController (Game|GetPlayerController)))
(event EventTick (DeltaSeconds)
  (bind pc (Game|GetPlayerController))
  (bind pos (Transformation|GetActorLocation))
  (Variables|Default|SetPrompt "")
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "R")
    (Game|OpenLevel(byName) :LevelName "L_CompoundEscape"))
  (if (not (Variables|Default|GetEscaped))
    (bind (mx my) (Game|Player|GetInputMouseDelta :self pc))
    (Pawn|Input|AddControllerYawInput :Val (* mx 0.65))
    (Pawn|Input|AddControllerPitchInput :Val (* my -0.65))
    (bind forward (Transformation|GetActorForwardVector))
    (bind right (Transformation|GetActorRightVector))
    (if (Game|Player|IsInputKeyDown :self pc :Key "W")
      (Pawn|Input|AddMovementInput :WorldDirection forward :ScaleValue 1.0))
    (if (Game|Player|IsInputKeyDown :self pc :Key "S")
      (Pawn|Input|AddMovementInput :WorldDirection forward :ScaleValue -1.0))
    (if (Game|Player|IsInputKeyDown :self pc :Key "D")
      (Pawn|Input|AddMovementInput :WorldDirection right :ScaleValue 1.0))
    (if (Game|Player|IsInputKeyDown :self pc :Key "A")
      (Pawn|Input|AddMovementInput :WorldDirection right :ScaleValue -1.0))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "SpaceBar") (Character|Jump))
    (if (not (Game|Player|IsInputKeyDown :self pc :Key "SpaceBar")) (Character|StopJumping))
    (if (< (.z pos) -500.0)
      (Transformation|SetActorLocation :NewLocation "(X=-600,Y=-2500,Z=540)" :bTeleport true))
    (Variables|Default|SetObjective "Find the security keycard in A / PROCESSING")
    (if (Variables|Default|GetHasKeycard)
      (Variables|Default|SetObjective "Restore the generator in B / POWER"))
    (if (and (Variables|Default|GetHasKeycard) (Variables|Default|GetPowerOnline))
      (Variables|Default|SetObjective "Authorize the exit in C / CONTROL"))
    (if (Variables|Default|GetGateUnlocked)
      (Variables|Default|SetObjective "Gate released. Follow EXIT signs to the south gate."))
    (bind use (Game|Player|WasInputKeyJustPressed :self pc :Key "E"))
    (if (and (not (Variables|Default|GetHasKeycard)) (< (Math|Vector|VectorLength :A (- pos (Math|Vector|MakeVector -1800.0 -1200.0 100.0))) 240.0))
      (Variables|Default|SetPrompt "[E] Collect SECURITY KEYCARD")
      (if use
        (Variables|Default|SetHasKeycard true)
        (bind cards (Actor|GetAllActorswithTag :Tag "Keycard"))
        (for card cards (Rendering|SetActorHiddenInGame :self card :bNewHidden true))))
    (if (< (Math|Vector|VectorLength :A (- pos (Math|Vector|MakeVector 1800.0 -200.0 100.0))) 270.0)
      (if (Variables|Default|GetPowerOnline)
        (Variables|Default|SetPrompt "GENERATOR ONLINE")
        (else
          (Variables|Default|SetPrompt "[E] Start COMPOUND GENERATOR")
          (if use
            (Variables|Default|SetPowerOnline true)
            (bind roomLights (Actor|GetAllActorswithTag :Tag "GeneratorRoomLight"))
            (for roomLight roomLights
              (bind pointLight (Utilities|Casting|CastToPointLight :Object roomLight)
                (:then
                  (Rendering|Components|Light|SetIntensity
                    :self (Class|Light|GetLightComponent :self pointLight)
                    :NewIntensity 60000.0))
                (:CastFailed)))))))
    (if (< (Math|Vector|VectorLength :A (- pos (Math|Vector|MakeVector -1800.0 1800.0 100.0))) 240.0)
      (if (not (Variables|Default|GetPowerOnline))
        (Variables|Default|SetPrompt "TERMINAL OFFLINE - restore power in B")
        (elif (not (Variables|Default|GetHasKeycard))
          (Variables|Default|SetPrompt "ACCESS DENIED - find keycard in A")
          (else
            (Variables|Default|SetPrompt "[E] Authorize EXIT GATE")
            (if use (Variables|Default|SetGateUnlocked true))))))
    (if (Variables|Default|GetGateUnlocked)
      (if (< (Variables|Default|GetGateHeight) 700.0)
        (Variables|Default|SetGateHeight (+ (Variables|Default|GetGateHeight) (* DeltaSeconds 180.0)))
        (bind gates (Actor|GetAllActorswithTag :Tag "ExitGate"))
        (for gate gates
          (Transformation|SetActorLocation :self gate :NewLocation (Math|Vector|MakeVector 1200.0 3400.0 (+ 250.0 (Variables|Default|GetGateHeight))))))
      (if (> (.y pos) 3600.0) (Variables|Default|SetEscaped true))))
  (if (Variables|Default|GetEscaped)
    (Variables|Default|SetObjective "COMPOUND BREACHED / You escaped.")
    (Variables|Default|SetPrompt "[R] Play again")))

